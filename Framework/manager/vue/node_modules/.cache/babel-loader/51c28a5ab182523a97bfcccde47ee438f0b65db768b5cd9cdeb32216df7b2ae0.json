{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: \"Password\",\n  data() {\n    const validatePassword = (rule, value, callback) => {\n      if (value === \"\") {\n        callback(new Error(\"Please confirm your password\"));\n      } else if (value !== this.user.newPassword) {\n        callback(new Error(\"Passwords do not match\"));\n      } else {\n        callback();\n      }\n    };\n    return {\n      user: JSON.parse(localStorage.getItem(\"xm-user\") || \"{}\"),\n      rules: {\n        password: [{\n          required: true,\n          message: \"Please enter your current password\",\n          trigger: \"blur\"\n        }],\n        newPassword: [{\n          required: true,\n          message: \"Please enter a new password\",\n          trigger: \"blur\"\n        }],\n        confirmPassword: [{\n          validator: validatePassword,\n          required: true,\n          trigger: \"blur\"\n        }]\n      }\n    };\n  },\n  created() {},\n  methods: {\n    update() {\n      this.$refs.formRef.validate(valid => {\n        if (valid) {\n          this.$request.put(\"/updatePassword\", this.user).then(res => {\n            if (res.code === \"200\") {\n              // Successfully updated\n              localStorage.removeItem(\"xm-user\"); // Clear cached user information\n              this.$message.success(\"Password changed successfully\");\n              this.$router.push(\"/login\");\n            } else {\n              this.$message.error(res.msg);\n            }\n          });\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["name","data","validatePassword","rule","value","callback","Error","user","newPassword","JSON","parse","localStorage","getItem","rules","password","required","message","trigger","confirmPassword","validator","created","methods","update","$refs","formRef","validate","valid","$request","put","then","res","code","removeItem","$message","success","$router","push","error","msg"],"sources":["src/views/manager/Password.vue"],"sourcesContent":["<template>\n  <div>\n    <el-card style=\"width: 50%\">\n      <el-form\n        ref=\"formRef\"\n        :model=\"user\"\n        :rules=\"rules\"\n        label-width=\"100px\"\n        style=\"padding-right: 50px\"\n      >\n        <el-form-item label=\"Current Password\" prop=\"password\">\n          <el-input\n            show-password\n            v-model=\"user.password\"\n            placeholder=\"Enter current password\"\n          ></el-input>\n        </el-form-item>\n        <el-form-item label=\"New Password\" prop=\"newPassword\">\n          <el-input\n            show-password\n            v-model=\"user.newPassword\"\n            placeholder=\"Enter new password\"\n          ></el-input>\n        </el-form-item>\n        <el-form-item label=\"Confirm New Password\" prop=\"confirmPassword\">\n          <el-input\n            show-password\n            v-model=\"user.confirmPassword\"\n            placeholder=\"Confirm new password\"\n          ></el-input>\n        </el-form-item>\n        <div style=\"text-align: center; margin-bottom: 20px\">\n          <el-button type=\"primary\" @click=\"update\">Confirm Change</el-button>\n        </div>\n      </el-form>\n    </el-card>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"Password\",\n  data() {\n    const validatePassword = (rule, value, callback) => {\n      if (value === \"\") {\n        callback(new Error(\"Please confirm your password\"));\n      } else if (value !== this.user.newPassword) {\n        callback(new Error(\"Passwords do not match\"));\n      } else {\n        callback();\n      }\n    };\n\n    return {\n      user: JSON.parse(localStorage.getItem(\"xm-user\") || \"{}\"),\n      rules: {\n        password: [\n          {\n            required: true,\n            message: \"Please enter your current password\",\n            trigger: \"blur\",\n          },\n        ],\n        newPassword: [\n          {\n            required: true,\n            message: \"Please enter a new password\",\n            trigger: \"blur\",\n          },\n        ],\n        confirmPassword: [\n          { validator: validatePassword, required: true, trigger: \"blur\" },\n        ],\n      },\n    };\n  },\n  created() {},\n  methods: {\n    update() {\n      this.$refs.formRef.validate((valid) => {\n        if (valid) {\n          this.$request.put(\"/updatePassword\", this.user).then((res) => {\n            if (res.code === \"200\") {\n              // Successfully updated\n              localStorage.removeItem(\"xm-user\"); // Clear cached user information\n              this.$message.success(\"Password changed successfully\");\n              this.$router.push(\"/login\");\n            } else {\n              this.$message.error(res.msg);\n            }\n          });\n        }\n      });\n    },\n  },\n};\n</script>\n\n<style scoped>\n.el-card {\n  background: #2f334d !important;\n  border-radius: 16px;\n  padding: 30px;\n  color: #f3f4f6;\n  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);\n  transition: all 0.3s ease-in-out;\n}\n.el-card:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 16px 32px rgba(0, 0, 0, 0.35);\n}\n\n.el-form-item__label {\n  font-weight: 600;\n  color: #cbd5e1;\n}\n\n.el-input__inner {\n  background: #1f2236;\n  border: 1px solid #3e4c7a;\n  color: #fff;\n  border-radius: 6px;\n  transition: all 0.3s ease;\n}\n.el-input__inner:focus {\n  border-color: #60a5fa;\n  box-shadow: 0 0 6px rgba(96, 165, 250, 0.5);\n}\n.el-input__inner::placeholder {\n  color: #94a3b8;\n}\n\n.el-button {\n  background-color: #5c7cfa;\n  border: none;\n  color: #fff;\n  font-weight: 600;\n  padding: 12px 24px;\n  border-radius: 8px;\n  transition: all 0.2s ease;\n}\n.el-button:hover {\n  background-color: #4f69dc;\n  transform: scale(1.05);\n  box-shadow: 0 4px 12px rgba(92, 124, 250, 0.3);\n}\n</style>\n"],"mappings":";AAwCA;EACAA,IAAA;EACAC,KAAA;IACA,MAAAC,gBAAA,GAAAA