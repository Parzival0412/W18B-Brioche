{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: \"Password\",\n  data() {\n    const validatePassword = (rule, value, callback) => {\n      if (value === \"\") {\n        callback(new Error(\"Please confirm your password\"));\n      } else if (value !== this.user.newPassword) {\n        callback(new Error(\"Passwords do not match\"));\n      } else {\n        callback();\n      }\n    };\n    return {\n      user: JSON.parse(localStorage.getItem(\"xm-user\") || \"{}\"),\n      rules: {\n        password: [{\n          required: true,\n          message: \"Please enter your current password\",\n          trigger: \"blur\"\n        }],\n        newPassword: [{\n          required: true,\n          message: \"Please enter a new password\",\n          trigger: \"blur\"\n        }],\n        confirmPassword: [{\n          validator: validatePassword,\n          required: true,\n          trigger: \"blur\"\n        }]\n      }\n    };\n  },\n  created() {},\n  methods: {\n    update() {\n      this.$refs.formRef.validate(valid => {\n        if (valid) {\n          this.$request.put(\"/updatePassword\", this.user).then(res => {\n            if (res.code === \"200\") {\n              // Successfully updated\n              localStorage.removeItem(\"xm-user\"); // Clear cached user information\n              this.$message.success(\"Password changed successfully\");\n              this.$router.push(\"/login\");\n            } else {\n              this.$message.error(res.msg);\n            }\n          });\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["name","data","validatePassword","rule","value","callback","Error","user","newPassword","JSON","parse","localStorage","getItem","rules","password","required","message","trigger","confirmPassword","validator","created","methods","update","$refs","formRef","validate","valid","$request","put","then","res","code","removeItem","$message","success","$router","push","error","msg"],"sources":["src/views/manager/Password.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <el-card style=\"width: 50%\">\r\n      <el-form\r\n        ref=\"formRef\"\r\n        :model=\"user\"\r\n        :rules=\"rules\"\r\n        label-width=\"100px\"\r\n        style=\"padding-right: 50px\"\r\n      >\r\n        <el-form-item label=\"Current Password\" prop=\"password\">\r\n          <el-input\r\n            show-password\r\n            v-model=\"user.password\"\r\n            placeholder=\"Enter current password\"\r\n          ></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"New Password\" prop=\"newPassword\">\r\n          <el-input\r\n            show-password\r\n            v-model=\"user.newPassword\"\r\n            placeholder=\"Enter new password\"\r\n          ></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"Confirm New Password\" prop=\"confirmPassword\">\r\n          <el-input\r\n            show-password\r\n            v-model=\"user.confirmPassword\"\r\n            placeholder=\"Confirm new password\"\r\n          ></el-input>\r\n        </el-form-item>\r\n        <div style=\"text-align: center; margin-bottom: 20px\">\r\n          <el-button type=\"primary\" @click=\"update\">Confirm Change</el-button>\r\n        </div>\r\n      </el-form>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"Password\",\r\n  data() {\r\n    const validatePassword = (rule, value, callback) => {\r\n      if (value === \"\") {\r\n        callback(new Error(\"Please confirm your password\"));\r\n      } else if (value !== this.user.newPassword) {\r\n        callback(new Error(\"Passwords do not match\"));\r\n      } else {\r\n        callback();\r\n      }\r\n    };\r\n\r\n    return {\r\n      user: JSON.parse(localStorage.getItem(\"xm-user\") || \"{}\"),\r\n      rules: {\r\n        password: [\r\n          {\r\n            required: true,\r\n            message: \"Please enter your current password\",\r\n            trigger: \"blur\",\r\n          },\r\n        ],\r\n        newPassword: [\r\n          {\r\n            required: true,\r\n            message: \"Please enter a new password\",\r\n            trigger: \"blur\",\r\n          },\r\n        ],\r\n        confirmPassword: [\r\n          { validator: validatePassword, required: true, trigger: \"blur\" },\r\n        ],\r\n      },\r\n    };\r\n  },\r\n  created() {},\r\n  methods: {\r\n    update() {\r\n      this.$refs.formRef.validate((valid) => {\r\n        if (valid) {\r\n          this.$request.put(\"/updatePassword\", this.user).then((res) => {\r\n            if (res.code === \"200\") {\r\n              // Successfully updated\r\n              localStorage.removeItem(\"xm-user\"); // Clear cached user information\r\n              this.$message.success(\"Password changed successfully\");\r\n              this.$router.push(\"/login\");\r\n            } else {\r\n              this.$message.error(res.msg);\r\n            }\r\n          });\r\n        }\r\n      });\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.el-card {\r\n  background: #2f334d !important;\r\n  border-radius: 16px;\r\n  padding: 30px;\r\n  color: #f3f4f6;\r\n  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);\r\n  transition: all 0.3s ease-in-out;\r\n}\r\n.el-card:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 16px 32px rgba(0, 0, 0, 0.35);\r\n}\r\n\r\n.el-form-item__label {\r\n  font-weight: 600;\r\n  color: #cbd5e1;\r\n}\r\n\r\n.el-input__inner {\r\n  background: #1f2236;\r\n  border: 1px solid #3e4c7a;\r\n  color: #fff;\r\n  border-radius: 6px;\r\n  transition: all 0.3s ease;\r\n}\r\n.el-input__inner:focus {\r\n  border-color: #60a5fa;\r\n  box-shadow: 0 0 6px rgba(96, 165, 250, 0.5);\r\n}\r\n.el-input__inner::placeholder {\r\n  color: #94a3b8;\r\n}\r\n\r\n.el-button {\r\n  background-color: #5c7cfa;\r\n  border: none;\r\n  color: #fff;\r\n  font-weight: 600;\r\n  padding: 1