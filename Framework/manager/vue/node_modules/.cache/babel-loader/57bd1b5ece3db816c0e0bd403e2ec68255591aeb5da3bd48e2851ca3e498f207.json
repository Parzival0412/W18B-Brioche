{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: \"Register\",\n  data() {\n    const validatePassword = (rule, confirmPass, callback) => {\n      if (!confirmPass) {\n        callback(new Error(\"Please confirm password\"));\n      } else if (confirmPass !== this.form.password) {\n        callback(new Error(\"The passwords do not match\"));\n      } else {\n        callback();\n      }\n    };\n    return {\n      form: {\n        sername: '',\n        password: '',\n        confirmPass: ''\n      },\n      rules: {\n        username: [{\n          required: true,\n          message: \"Please enter account\",\n          trigger: \"blur\"\n        }],\n        password: [{\n          required: true,\n          message: \"Please enter password\",\n          trigger: \"blur\"\n        }],\n        confirmPass: [{\n          validator: validatePassword,\n          trigger: \"blur\"\n        }]\n      }\n    };\n  },\n  methods: {\n    register() {\n      this.$refs.formRef.validate(valid => {\n        if (valid) {\n          const {\n            username,\n            password\n          } = this.form;\n          this.$request.post(\"/register\", {\n            username,\n            password\n          }).then(res => {\n            if (res.code === \"200\") {\n              this.$message.success(\"Registration successful\");\n              this.$router.push(\"/login\");\n            } else {\n              this.$message.error(res.msg);\n            }\n          });\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["name","data","validatePassword","rule","confirmPass","callback","Error","form","password","sername","rules","username","required","message","trigger","validator","methods","register","$refs","formRef","validate","valid","$request","post","then","res","code","$message","success","$router","push","error","msg"],"sources":["src/views/Register.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-container\">\r\n    <!-- 左侧大标题 -->\r\n    <div class=\"login-left\">\r\n      <div class=\"brand-title\">BRIOCHE<br />EXPRESS</div>\r\n    </div>\r\n\r\n    <!-- 右侧注册框 -->\r\n    <div class=\"login-right\">\r\n      <div class=\"login-box\">\r\n        <div class=\"login-title\">Welcome to register</div>\r\n        <el-form :model=\"form\" :rules=\"rules\" ref=\"formRef\">\r\n          <el-form-item prop=\"username\">\r\n            <el-input\r\n                placeholder=\"Please enter account\"\r\n                v-model=\"form.username\"\r\n            />\r\n          </el-form-item>\r\n          <el-form-item prop=\"password\">\r\n            <el-input\r\n                placeholder=\"Please enter password\"\r\n                show-password\r\n                v-model=\"form.password\"\r\n            />\r\n          </el-form-item>\r\n          <el-form-item prop=\"confirmPass\">\r\n            <el-input\r\n                placeholder=\"Please confirm password\"\r\n                show-password\r\n                v-model=\"form.confirmPass\"\r\n            />\r\n          </el-form-item>\r\n          <el-form-item>\r\n            <el-button type=\"primary\" class=\"login-btn\" @click=\"register\">Register</el-button>\r\n          </el-form-item>\r\n          <el-form-item>\r\n            <div class=\"register-text\">\r\n              Already have an account?\r\n              <span class=\"link\" @click=\"$router.push('/login')\">Log in</span>\r\n            </div>\r\n          </el-form-item>\r\n        </el-form>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"Register\",\r\n  data() {\r\n    const validatePassword = (rule, confirmPass, callback) => {\r\n      if (!confirmPass) {\r\n        callback(new Error(\"Please confirm password\"));\r\n      } else if (confirmPass !== this.form.password) {\r\n        callback(new Error(\"The passwords do not match\"));\r\n      } else {\r\n        callback();\r\n      }\r\n    };\r\n    return {\r\n      form: {\r\n        sername: '',\r\n        password: '',\r\n        confirmPass: ''\r\n      },\r\n      rules: {\r\n        username: [\r\n          { required: true, message: \"Please enter account\", trigger: \"blur\" },\r\n        ],\r\n        password: [\r\n          { required: true, message: \"Please enter password\", trigger: \"blur\" },\r\n        ],\r\n        confirmPass: [{ validator: validatePassword, trigger: \"blur\" }],\r\n      },\r\n    };\r\n  },\r\n  methods: {\r\n    register() {\r\n      this.$refs.formRef.validate((valid) => {\r\n        if (valid) {\r\n          const { username, password } = this.form;\r\n          this.$request.post(\"/register\", { username, password }).then((res) => {\r\n            if (res.code === \"200\") {\r\n              this.$message.success(\"Registration successful\");\r\n              this.$router.push(\"/login\");\r\n            } else {\r\n              this.$message.error(res.msg);\r\n            }\r\n          });\r\n        }\r\n      });\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.login-container {\r\n  display: flex;\r\n  height: 100vh;\r\n  background-color: #fff;\r\n}\r\n\r\n.login-left {\r\n  position: relative;\r\n  flex: 1;\r\n  background-image: url(\"@/assets/imgs/bg-left.jpg\");\r\n  background-size: cover;\r\n  background-position: center;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  overflow: hidden;\r\n}\r\n\r\n.login-left::before {\r\n  content: \"\";\r\n  position: absolute;\r\n  inset: 0; /* top: 0; bottom: 0; left: 0; right: 0; */\r\n  background-color: white; /* 半透明白色遮罩 */\r\n  opacity: 0.3; /* 越大越“淡”，你可以调成 0.3 ~ 0.8 */\r\n  z-index: 1;\r\n}\r\n\r\n.brand-title {\r\n  position: relative;\r\n  z-index: 2;\r\n  font-size: 110px;\r\n  font-weight: 900;\r\n  color: #000;\r\n  text-align: center;\r\n  line-height: 1.2;\r\n}\r\n\r\n.login-right {\r\n  flex: 1;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background-color: white;\r\n}\r\n\r\n.login-box {\r\n  width: 500px;\r\n  background: #fff;\r\n  padding: 40px;\r\n  border-radius: 14px;\r\n  box-shadow: 0 8px 45px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.login-title {\r\n  text-align: center;\r\n  font-size: 32px;\r\n  font-weight: 700;\r\n  margin-bottom: 30px;\r\n  color: #333;\r\n}\r\n\r\n.el-form-item {\r\n  margin-bottom: 22px;\r\n}\r\n\r\n.el-input__inner {\r\n  font-size: 16px !important;\r\n  padding: 12px 14px !important;\r\n}\r\n\r\n.login-btn {\r\n  width: 100%;\r\n  background-color: #000;\r\n  border-color: #000;\r\n  color: white;\r\n  font-size: 18px;\r\n  padding: 14px 0;\r\n  border-radius: 6px;\r\n}\r\n\r\n.register-text {\r\n  text-align: center;\r\n  font-size: 15px;\r\n  color: #666;\r\n  margin-top: 10px;\r\n}\r\n\r\n.link {\r\n  color: #2a60c9;\r\n  cursor: pointer;\r\n  margin-left: 5px;\r\n  font-weight: 500;\r\n}\r\n</style>\r\n"],"mappings":";AAgDA;EACAA,IAAA;EACAC,KAAA;IACA,MAAAC,gBAAA,GAAAA,CAAAC,IAAA,EAAAC,WAAA,EAAAC,QAAA;MACA,KAAAD,WAAA;QACAC,QAAA,KAAAC,KAAA;MACA,WAAAF,WAAA,UAAAG,IAAA,CAAAC,QAAA;QACAH,QAAA,KAAAC,KAAA;MACA;QACAD,QAAA;MACA;IACA;IACA;MACAE,IAAA;QACAE,OAAA;QACAD,QAAA;QACAJ,WAAA;MACA;MACAM,KAAA;QACAC,QAAA,GACA;UAAAC,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAN,QAAA,GACA;UAAAI,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAV,WAAA;UAAAW,SAAA,EAAAb,gBAAA;UAAAY,OAAA;QAAA;MACA;IACA;EACA;EACAE,OAAA;IACAC,SAAA;MACA,KAAAC,KAAA,CAAAC,OAAA,CAAAC,QAAA,CAAAC,KAAA;QACA,IAAAA,KAAA;UACA;YAAAV,QAAA;YAAAH;UAAA,SAAAD,IAAA;UACA,KAAAe,QAAA,CAAAC,IAAA;YAAAZ,QAAA;YAAAH;UAAA,GAAAgB,IAAA,CAAAC,GAAA;YACA,IAAAA,GAAA,CAAAC,IAAA;cACA,KAAAC,QAAA,CAAAC,OAAA;cACA,KAAAC,OAAA,CAAAC,IAAA;YACA;cACA,KAAAH,QAAA,CAAAI,KAAA,CAAAN,GAAA,CAAAO,GAAA;YACA;UACA;QACA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}