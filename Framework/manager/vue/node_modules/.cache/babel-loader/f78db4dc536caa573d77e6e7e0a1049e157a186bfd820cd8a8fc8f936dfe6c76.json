{"ast":null,"code":"export default {\n  name: 'Dashboard'\n};","map":{"version":3,"names":["name"],"sources":["src/views/Front.vue"],"sourcesContent":["<template>\n  <div class=\"main-content\">\n    <!-- 顶部提醒卡片 -->\n    <div class=\"card notice-card\">\n      <div class=\"card-left\">\n        <h3>📢 Hold on a minute!</h3>\n        <p>Some identification is required to enable sending and receiving invoices.</p>\n        <el-button type=\"primary\">Add Identification</el-button>\n        <div class=\"link-muted\">Don't show again</div>\n      </div>\n      <div class=\"card-right\">\n        <img src=\"@/assets/imgs/logo.png\" alt=\"notice\" class=\"notice-img\" />\n      </div>\n    </div>\n\n    <!-- 两栏主内容区 -->\n    <div class=\"grid-2\">\n      <!-- 钱进钱出 -->\n      <div class=\"card\">\n        <h4>Money In and Out</h4>\n        <div class=\"entry\">\n          <b>Invoice 01234</b> has been paid <span class=\"badge green\">Paid</span>\n        </div>\n        <div class=\"entry\">\n          <b>Purchase order 123456</b> needs your approval\n          <el-button size=\"mini\" type=\"primary\">Approve Now</el-button>\n        </div>\n        <div class=\"entry\">\n          <b>Invoice 346123</b> needs your approval\n          <el-button size=\"mini\" type=\"primary\">Approve Now</el-button>\n        </div>\n        <div class=\"entry\">\n          A new credit note has been received\n          <el-button size=\"mini\" plain>View details</el-button>\n        </div>\n      </div>\n\n      <!-- 网络动态 -->\n      <div class=\"card\">\n        <h4>Network Feed</h4>\n        <div class=\"entry\">\n          [Supplier Name] is missing ABN\n          <el-button size=\"mini\" type=\"primary\">Add ABN</el-button>\n        </div>\n        <div class=\"entry\">\n          [Supplier Name] is now on PEPPOL Network\n          <span class=\"badge green\">eInvoicing Ready</span>\n        </div>\n        <div class=\"entry\">\n          [Customer] is missing email\n          <el-button size=\"mini\" type=\"primary\">Add Email</el-button>\n        </div>\n        <div class=\"entry\">\n          [Customer] wants to connect with you!\n          <el-button size=\"mini\" type=\"primary\">Enable</el-button>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'Dashboard',\n}\n</script>\n\n<style scoped>\n.main-content {\n  background-color: #f4f5f7;\n  min-height: 100vh;\n  padding: 30px;\n  box-sizing: border-box;\n}\n\n/* 白色卡片 */\n.card {\n  background: #fff;\n  border-radius: 10px;\n  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);\n  padding: 24px;\n  margin-bottom: 24px;\n}\n\n/* 顶部提醒卡片结构 */\n.notice-card {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.card-left {\n  flex: 1;\n}\n.card-right {\n  width: 180px;\n  text-align: right;\n}\n.notice-img {\n  width: 100%;\n  max-width: 140px;\n}\n\n/* 主体内容两列布局 */\n.grid-2 {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 24px;\n}\n\n/* 内容项 */\n.entry {\n  margin-bottom: 14px;\n  font-size: 15px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n/* 蓝色链接文本 */\n.link-muted {\n  font-size: 13px;\n  color: #007bff;\n  cursor: pointer;\n  margin-top: 10px;\n}\n.link-muted:hover {\n  text-decoration: underline;\n}\n\n/* 状态徽章 */\n.badge {\n  padding: 3px 8px;\n  font-size: 12px;\n  border-radius: 6px;\n  background-color: #e0e0e0;\n  color: #555;\n}\n.badge.green {\n  background-color: #d4edda;\n  color: #155724;\n}\n\n/* 调整 Element 按钮大小 */\n:deep(.el-button--mini) {\n  padding: 6px 12px;\n  font-size: 13px;\n}\n\n/* 蓝色主按钮更接近 Link4 */\n:deep(.el-button--primary) {\n  background-color: #007bff;\n  border-color: #007bff;\n}\n</style>\n"],"mappings":"AA8DA;EACAA,IAAA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}