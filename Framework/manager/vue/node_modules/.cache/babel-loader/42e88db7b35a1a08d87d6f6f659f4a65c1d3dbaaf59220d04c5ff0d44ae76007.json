{"ast":null,"code":"export default {\n  name: \"Invoice\",\n  data() {\n    return {\n      tableData: [],\n      pageNum: 1,\n      pageSize: 10,\n      total: 0,\n      invoiceNumber: null,\n      fromVisible: false,\n      form: {},\n      ids: []\n    };\n  },\n  created() {\n    this.load(1);\n  },\n  methods: {\n    load(pageNum) {\n      if (pageNum) this.pageNum = pageNum;\n      this.$request.get('/notice/selectPage', {\n        params: {\n          pageNum: this.pageNum,\n          pageSize: this.pageSize,\n          invoiceNumber: this.invoiceNumber\n        }\n      }).then(res => {\n        this.tableData = Array.isArray(res.data) ? res.data : [res.data];\n        this.total = res.data?.total;\n      });\n    },\n    reset() {\n      this.invoiceNumber = null;\n      this.load(1);\n    },\n    handleCurrentChange(pageNum) {\n      this.load(pageNum);\n    },\n    handleAdd() {\n      this.form = {};\n      this.fromVisible = true;\n    },\n    delBatch() {\n      if (!this.ids.length) {\n        this.$message.warning(\"请选择要删除的发票\");\n        return;\n      }\n      this.$confirm(\"您确定要批量删除这些发票吗？\", \"确认删除\", {\n        type: \"warning\"\n      }).then(() => {\n        this.$request.delete(\"/notice/delete/batch\", {\n          data: this.ids\n        }).then(res => {\n          if (res.code === \"200\") {\n            this.$message.success(\"批量删除成功\");\n            this.load(1);\n          } else {\n            this.$message.error(res.msg);\n          }\n        });\n      }).catch(() => {});\n    },\n    handleSelectionChange(rows) {\n      this.ids = rows.map(row => row.invoiceId);\n    }\n  }\n};","map":{"version":3,"names":["name","data","tableData","pageNum","pageSize","total","invoiceNumber","fromVisible","form","ids","created","load","methods","$request","get","params","then","res","Array","isArray","reset","handleCurrentChange","handleAdd","delBatch","length","$message","warning","$confirm","type","delete","code","success","error","msg","catch","handleSelectionChange","rows","map","row","invoiceId"],"sources":["src/views/manager/Notice.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"search\">\r\n      <el-input placeholder=\"请输入发票编号查询\" style=\"width: 200px\" v-model=\"invoiceNumber\"></el-input>\r\n      <el-button type=\"info\" plain style=\"margin-left: 10px\" @click=\"load(1)\">查询</el-button>\r\n      <el-button type=\"warning\" plain style=\"margin-left: 10px\" @click=\"reset\">重置</el-button>\r\n    </div>\r\n\r\n    <div class=\"operation\">\r\n      <el-button type=\"primary\" plain @click=\"handleAdd\">新增</el-button>\r\n      <el-button type=\"danger\" plain @click=\"delBatch\">批量删除</el-button>\r\n    </div>\r\n\r\n    <div class=\"table\">\r\n      <el-table :data=\"tableData\" stripe @selection-change=\"handleSelectionChange\">\r\n        <el-table-column type=\"selection\" width=\"55\" align=\"center\"></el-table-column>\r\n        <el-table-column prop=\"invoiceId\" label=\"发票 ID\" width=\"80\" align=\"center\" sortable></el-table-column>\r\n        <el-table-column prop=\"invoiceNumber\" label=\"发票编号\" show-overflow-tooltip></el-table-column>\r\n        <el-table-column prop=\"issueDate\" label=\"开票日期\">\r\n          <template v-slot=\"scope\">\r\n            {{ scope.row.issueDate ? scope.row.issueDate.split(\"T\")[0] : '' }}\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"supplierName\" label=\"供应商\"></el-table-column>\r\n        <el-table-column prop=\"customerName\" label=\"客户\"></el-table-column>\r\n        <el-table-column label=\"商品明细\">\r\n          <template v-slot=\"scope\">\r\n            {{\r\n              scope.row.items ? JSON.parse(scope.row.items).item + \" - ¥\" + JSON.parse(scope.row.items).price : \"无数据\"\r\n            }}\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"totalAmount\" label=\"总金额\"></el-table-column>\r\n        <el-table-column prop=\"gstIncluded\" label=\"是否含 GST\">\r\n          <template v-slot=\"scope\">\r\n            {{ scope.row.gstIncluded ? \"是\" : \"否\" }}\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n    </div>\r\n\r\n    <div class=\"pagination\">\r\n      <el-pagination\r\n          background\r\n          @current-change=\"handleCurrentChange\"\r\n          :current-page=\"pageNum\"\r\n          :page-sizes=\"[5, 10, 20]\"\r\n          :page-size=\"pageSize\"\r\n          layout=\"total, prev, pager, next\"\r\n          :total=\"total\">\r\n      </el-pagination>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"Invoice\",\r\n  data() {\r\n    return {\r\n      tableData: [],\r\n      pageNum: 1,\r\n      pageSize: 10,\r\n      total: 0,\r\n      invoiceNumber: null,\r\n      fromVisible: false,\r\n      form: {},\r\n      ids: []\r\n    }\r\n  },\r\n  created() {\r\n    this.load(1)\r\n  },\r\n  methods: {\r\n    load(pageNum) {\r\n      if (pageNum) this.pageNum = pageNum;\r\n      this.$request.get('/notice/selectPage', {\r\n        params: {\r\n          pageNum: this.pageNum,\r\n          pageSize: this.pageSize,\r\n          invoiceNumber: this.invoiceNumber,\r\n        }\r\n      }).then(res => {\r\n        this.tableData = Array.isArray(res.data) ? res.data : [res.data];\r\n        this.total = res.data?.total;\r\n      })\r\n    },\r\n    reset() {\r\n      this.invoiceNumber = null;\r\n      this.load(1);\r\n    },\r\n    handleCurrentChange(pageNum) {\r\n      this.load(pageNum);\r\n    },\r\n    handleAdd() {\r\n      this.form = {};\r\n      this.fromVisible = true;\r\n    },\r\n    delBatch() {\r\n      if (!this.ids.length) {\r\n        this.$message.warning(\"请选择要删除的发票\");\r\n        return;\r\n      }\r\n      this.$confirm(\"您确定要批量删除这些发票吗？\", \"确认删除\", { type: \"warning\" })\r\n          .then(() => {\r\n            this.$request.delete(\"/notice/delete/batch\", { data: this.ids }).then(res => {\r\n              if (res.code === \"200\") {\r\n                this.$message.success(\"批量删除成功\");\r\n                this.load(1);\r\n              } else {\r\n                this.$message.error(res.msg);\r\n              }\r\n            });\r\n          })\r\n          .catch(() => {});\r\n    },\r\n    handleSelectionChange(rows) {\r\n      this.ids = rows.map(row => row.invoiceId);\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n</style>\r\n"],"mappings":"AAwDA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;MACAC,OAAA;MACAC,QAAA;MACAC,KAAA;MACAC,aAAA;MACAC,WAAA;MACAC,IAAA;MACAC,GAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAD,KAAAR,OAAA;MACA,IAAAA,OAAA,OAAAA,OAAA,GAAAA,OAAA;MACA,KAAAU,QAAA,CAAAC,GAAA;QACAC,MAAA;UACAZ,OAAA,OAAAA,OAAA;UACAC,QAAA,OAAAA,QAAA;UACAE,aAAA,OAAAA;QACA;MACA,GAAAU,IAAA,CAAAC,GAAA;QACA,KAAAf,SAAA,GAAAgB,KAAA,CAAAC,OAAA,CAAAF,GAAA,CAAAhB,IAAA,IAAAgB,GAAA,CAAAhB,IAAA,IAAAgB,GAAA,CAAAhB,IAAA;QACA,KAAAI,KAAA,GAAAY,GAAA,CAAAhB,IAAA,EAAAI,KAAA;MACA;IACA;IACAe,MAAA;MACA,KAAAd,aAAA;MACA,KAAAK,IAAA;IACA;IACAU,oBAAAlB,OAAA;MACA,KAAAQ,IAAA,CAAAR,OAAA;IACA;IACAmB,UAAA;MACA,KAAAd,IAAA;MACA,KAAAD,WAAA;IACA;IACAgB,SAAA;MACA,UAAAd,GAAA,CAAAe,MAAA;QACA,KAAAC,QAAA,CAAAC,OAAA;QACA;MACA;MACA,KAAAC,QAAA;QAAAC,IAAA;MAAA,GACAZ,IAAA;QACA,KAAAH,QAAA,CAAAgB,MAAA;UAAA5B,IAAA,OAAAQ;QAAA,GAAAO,IAAA,CAAAC,GAAA;UACA,IAAAA,GAAA,CAAAa,IAAA;YACA,KAAAL,QAAA,CAAAM,OAAA;YACA,KAAApB,IAAA;UACA;YACA,KAAAc,QAAA,CAAAO,KAAA,CAAAf,GAAA,CAAAgB,GAAA;UACA;QACA;MACA,GACAC,KAAA;IACA;IACAC,sBAAAC,IAAA;MACA,KAAA3B,GAAA,GAAA2B,IAAA,CAAAC,GAAA,CAAAC,GAAA,IAAAA,GAAA,CAAAC,SAAA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}