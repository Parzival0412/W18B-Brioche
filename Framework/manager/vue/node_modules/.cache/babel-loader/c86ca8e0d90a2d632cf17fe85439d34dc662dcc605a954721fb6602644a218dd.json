{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  data() {\n    return {\n      user: JSON.parse(localStorage.getItem(\"xm-user\") || \"{}\")\n    };\n  },\n  methods: {\n    logout() {\n      localStorage.removeItem(\"xm-user\");\n      this.$router.push(\"/login\");\n    },\n    updateUser() {\n      this.user = JSON.parse(localStorage.getItem(\"xm-user\") || \"{}\");\n    }\n  }\n};","map":{"version":3,"names":["data","user","JSON","parse","localStorage","getItem","methods","logout","removeItem","$router","push","updateUser"],"sources":["src/views/Manager.vue"],"sourcesContent":["<template>\n  <div class=\"manager-container\">\n    <!-- 顶部 -->\n    <div class=\"manager-header\">\n      <div class=\"manager-header-left\">\n        <img src=\"@/assets/imgs/logo.png\" />\n        <div class=\"title-wrap\">\n          <div class=\"title-line1\">Brioche</div>\n          <div class=\"title-line2\">Express</div>\n        </div>\n      </div>\n      <div class=\"manager-header-center\">\n        <el-breadcrumb separator-class=\"el-icon-arrow-right\">\n          <el-breadcrumb-item :to=\"{ path: '/' }\"></el-breadcrumb-item>\n          <el-breadcrumb-item :to=\"{ path: $route.path }\">\n            {{ $route.meta.name }}\n          </el-breadcrumb-item>\n        </el-breadcrumb>\n      </div>\n    </div>\n\n    <!-- 主体 -->\n    <div class=\"manager-main\">\n      <!-- 左侧菜单栏 -->\n      <div class=\"manager-main-left\">\n        <div class=\"menu-wrapper\">\n          <el-menu\n              :default-openeds=\"['setting']\"\n              router\n              style=\"border: none\"\n              :default-active=\"$route.path\"\n          >\n            <el-menu-item index=\"/home\">\n              <i class=\"el-icon-s-home\"></i>\n              <span slot=\"title\">Home</span>\n            </el-menu-item>\n\n            <el-menu-item index=\"/notice\">\n              <i class=\"el-icon-document\"></i>\n              <span slot=\"title\">Invoice</span>\n            </el-menu-item>\n\n            <el-menu-item index=\"/admin\">\n              <i class=\"el-icon-menu\"></i>\n              <span slot=\"title\">User information</span>\n            </el-menu-item>\n\n            <el-submenu index=\"setting\">\n              <template slot=\"title\">\n                <i class=\"el-icon-setting\"></i>\n                <span>Setting</span>\n              </template>\n              <el-menu-item index=\"/person\">Personal info</el-menu-item>\n              <el-menu-item index=\"/password\">Change password</el-menu-item>\n            </el-submenu>\n          </el-menu>\n        </div>\n\n        <!-- ✅ 固定底部 logout -->\n        <div class=\"logout-container\" @click=\"logout\">\n          <i class=\"el-icon-switch-button\" style=\"margin-right: 6px;\"></i>\n          <span>Logout</span>\n        </div>\n      </div>\n\n      <!-- 右侧内容区域 -->\n      <div class=\"manager-main-right\">\n        <router-view @update:user=\"updateUser\" />\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      user: JSON.parse(localStorage.getItem(\"xm-user\") || \"{}\"),\n    };\n  },\n  methods: {\n    logout() {\n      localStorage.removeItem(\"xm-user\");\n      this.$router.push(\"/login\");\n    },\n    updateUser() {\n      this.user = JSON.parse(localStorage.getItem(\"xm-user\") || \"{}\");\n    },\n  },\n};\n</script>\n"],"mappings":";AA0EA;EACAA,KAAA;IACA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;IACA;EACA;EACAC,OAAA;IACAC,OAAA;MACAH,YAAA,CAAAI,UAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;IACA;IACAC,WAAA;MACA,KAAAV,IAAA,GAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}