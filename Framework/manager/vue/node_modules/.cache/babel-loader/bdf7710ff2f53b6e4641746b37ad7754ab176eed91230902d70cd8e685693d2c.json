{"ast":null,"code":"export default {\n  name: \"Home\",\n  data() {\n    return {\n      user: JSON.parse(localStorage.getItem(\"xm-user\") || \"{}\"),\n      notices: [{\n        id: 1,\n        time: \"2025-04-10\",\n        title: \"Brioche Express v1.2.0 Released\",\n        content: \"New batch import feature added, UI optimized, and PDF export bug fixed.\"\n      }, {\n        id: 2,\n        time: \"2025-04-08\",\n        title: \"Scheduled Maintenance\",\n        content: \"System maintenance on April 12th, 02:00–04:00. The service may be briefly unavailable.\"\n      }, {\n        id: 3,\n        time: \"2025-04-05\",\n        title: \"Permissions Module Launched\",\n        content: \"Admins can now assign granular roles and customize approval workflows.\"\n      }, {\n        id: 4,\n        time: \"2025-03-30\",\n        title: \"Security Patch Applied\",\n        content: \"Login and upload modules have been updated with the latest security patches.\"\n      }]\n    };\n  }\n};","map":{"version":3,"names":["name","data","user","JSON","parse","localStorage","getItem","notices","id","time","title","content"],"sources":["src/views/manager/Home.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <!-- 欢迎卡片 -->\r\n    <div class=\"card welcome-card\">\r\n      Hello，{{ user?.name }}！Welcome to Brioche Express！\r\n    </div>\r\n\r\n    <!-- Announcement 列表 -->\r\n    <div style=\"display: flex; margin: 10px 0\">\r\n      <div style=\"width: 100%\" class=\"card announcement-card\">\r\n        <div class=\"announcement-title\">Announcement list</div>\r\n        <el-timeline reverse>\r\n          <el-timeline-item\r\n              v-for=\"item in notices\"\r\n              :key=\"item.id\"\r\n              :timestamp=\"item.time\"\r\n              placement=\"top\"\r\n          >\r\n            <div class=\"notice-item-title\">{{ item.title }}</div>\r\n            <div class=\"notice-item-content\">{{ item.content }}</div>\r\n          </el-timeline-item>\r\n        </el-timeline>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"Home\",\r\n  data() {\r\n    return {\r\n      user: JSON.parse(localStorage.getItem(\"xm-user\") || \"{}\"),\r\n      notices: [\r\n        {\r\n          id: 1,\r\n          time: \"2025-04-10\",\r\n          title: \"Brioche Express v1.2.0 Released\",\r\n          content:\r\n              \"New batch import feature added, UI optimized, and PDF export bug fixed.\",\r\n        },\r\n        {\r\n          id: 2,\r\n          time: \"2025-04-08\",\r\n          title: \"Scheduled Maintenance\",\r\n          content:\r\n              \"System maintenance on April 12th, 02:00–04:00. The service may be briefly unavailable.\",\r\n        },\r\n        {\r\n          id: 3,\r\n          time: \"2025-04-05\",\r\n          title: \"Permissions Module Launched\",\r\n          content:\r\n              \"Admins can now assign granular roles and customize approval workflows.\",\r\n        },\r\n        {\r\n          id: 4,\r\n          time: \"2025-03-30\",\r\n          title: \"Security Patch Applied\",\r\n          content:\r\n              \"Login and upload modules have been updated with the latest security patches.\",\r\n        },\r\n      ],\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 公共卡片样式 */\r\n.card {\r\n  background: #fff;\r\n  border-radius: 8px;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);\r\n  font-family: \"Helvetica Neue\", Arial, sans-serif;\r\n}\r\n\r\n/* 欢迎卡片 */\r\n.welcome-card {\r\n  padding: 15px;\r\n  font-size: 15px;\r\n  font-weight: 500;\r\n  color: #333;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n/* Announcement 卡片 */\r\n.announcement-card {\r\n  padding: 20px;\r\n}\r\n\r\n/* 标题 */\r\n.announcement-title {\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n  margin-bottom: 16px;\r\n  color: #222;\r\n}\r\n\r\n/* 时间线项标题 */\r\n.notice-item-title {\r\n  font-size: 14px;\r\n  font-weight: 500;\r\n  color: #333;\r\n}\r\n\r\n/* 时间线项内容 */\r\n.notice-item-content {\r\n  font-size: 12px;\r\n  color: #555;\r\n  margin-top: 4px;\r\n}\r\n\r\n/* Element UI 时间戳字体 */\r\n.el-timeline-item__timestamp {\r\n  font-size: 12px !important;\r\n  color: #888 !important;\r\n}\r\n</style>\r\n"],"mappings":"AA4BA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,OAAA,GACA;QACAC,EAAA;QACAC,IAAA;QACAC,KAAA;QACAC,OAAA,EACA;MACA,GACA;QACAH,EAAA;QACAC,IAAA;QACAC,KAAA;QACAC,OAAA,EACA;MACA,GACA;QACAH,EAAA;QACAC,IAAA;QACAC,KAAA;QACAC,OAAA,EACA;MACA,GACA;QACAH,EAAA;QACAC,IAAA;QACAC,KAAA;QACAC,OAAA,EACA;MACA;IAEA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}