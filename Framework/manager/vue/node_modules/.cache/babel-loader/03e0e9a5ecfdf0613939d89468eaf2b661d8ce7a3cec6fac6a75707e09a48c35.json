{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: \"Manager\",\n  data() {\n    return {\n      user: JSON.parse(localStorage.getItem(\"xm-user\") || \"{}\")\n    };\n  },\n  created() {\n    if (!this.user.id) {\n      this.$router.push(\"/login\");\n    }\n  },\n  methods: {\n    updateUser() {\n      this.user = JSON.parse(localStorage.getItem(\"xm-user\") || \"{}\"); // 重新获取下用户的最新信息\n    },\n    goToPerson() {\n      if (this.user.role === \"ADMIN\") {\n        this.$router.push(\"/adminPerson\");\n      }\n    },\n    logout() {\n      localStorage.removeItem(\"xm-user\");\n      this.$router.push(\"/login\");\n    }\n  }\n};","map":{"version":3,"names":["name","data","user","JSON","parse","localStorage","getItem","created","id","$router","push","methods","updateUser","goToPerson","role","logout","removeItem"],"sources":["src/views/Manager.vue"],"sourcesContent":["<template>\n  <div class=\"manager-container\">\n    <!--  头部  -->\n    <div class=\"manager-header\">\n      <div class=\"manager-header-left\">\n        <img src=\"@/assets/imgs/logo.png\" />\n        <div class=\"title-wrap\">\n          <div class=\"title-line1\">Brioche</div>\n          <div class=\"title-line2\">Express</div>\n        </div>\n      </div>\n\n      <div class=\"manager-header-center\">\n        <el-breadcrumb separator-class=\"el-icon-arrow-right\">\n          <el-breadcrumb-item :to=\"{ path: '/' }\"\n            >front page</el-breadcrumb-item\n          >\n          <el-breadcrumb-item :to=\"{ path: $route.path }\">{{\n            $route.meta.name\n          }}</el-breadcrumb-item>\n        </el-breadcrumb>\n      </div>\n\n      <div class=\"manager-header-right\">\n          <div class=\"avatar\">\n            <img\n              :src=\"\n                user.avatar ||\n                'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\n              \"\n            />\n            <div>{{ user.name || \"administrator\" }}</div>\n          </div>\n      </div>\n\n    </div>\n\n    <!--  主体  -->\n    <div class=\"manager-main\">\n      <!--  侧边栏  -->\n      <div class=\"manager-main-left\">\n        <div class=\"menu-wrapper\">\n          <el-menu\n            :default-openeds=\"['info', 'user']\"\n            router\n            style=\"border: none\"\n            :default-active=\"$route.path\"\n          >\n            <el-menu-item index=\"/home\">\n              <i class=\"el-icon-s-home\"></i>\n              <span slot=\"title\">Home page</span>\n            </el-menu-item>\n\n            <el-menu-item index=\"/notice\">\n              <i class=\"el-icon-document\"></i>\n              <span slot=\"title\">Invoice</span>\n            </el-menu-item>\n\n            <el-menu-item index=\"/admin\">\n              <i class=\"el-icon-menu\"></i>\n              <span slot=\"title\">User information</span>\n            </el-menu-item>\n\n            <el-submenu index=\"setting\">\n              <template slot=\"title\">\n                <i class=\"el-icon-setting\"></i>\n                <span>Setting</span>\n              </template>\n              <el-menu-item index=\"/person\">Personal info</el-menu-item>\n              <el-menu-item index=\"/password\">Change password</el-menu-item>\n            </el-submenu>\n          </el-menu>\n        </div>\n      </div>\n\n      <!-- ✅ logout 固定底部 -->\n      <div class=\"logout-container\" @click=\"logout\">\n        <i class=\"el-icon-switch-button\" style=\"margin-right: 6px;\"></i>\n        <span>Logout</span>\n      </div>\n\n      <!--  数据表格  -->\n      <div class=\"manager-main-right\">\n        <router-view @update:user=\"updateUser\" />\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"Manager\",\n  data() {\n    return {\n      user: JSON.parse(localStorage.getItem(\"xm-user\") || \"{}\"),\n    };\n  },\n  created() {\n    if (!this.user.id) {\n      this.$router.push(\"/login\");\n    }\n  },\n  methods: {\n    updateUser() {\n      this.user = JSON.parse(localStorage.getItem(\"xm-user\") || \"{}\"); // 重新获取下用户的最新信息\n    },\n    goToPerson() {\n      if (this.user.role === \"ADMIN\") {\n        this.$router.push(\"/adminPerson\");\n      }\n    },\n    logout() {\n      localStorage.removeItem(\"xm-user\");\n      this.$router.push(\"/login\");\n    },\n  },\n};\n</script>\n\n<style scoped>\n@import \"@/assets/css/manager.css\";\n</style>\n"],"mappings":";AA0FA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;IACA;EACA;EACAC,QAAA;IACA,UAAAL,IAAA,CAAAM,EAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;IACA;EACA;EACAC,OAAA;IACAC,WAAA;MACA,KAAAV,IAAA,GAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;IACA;IACAO,WAAA;MACA,SAAAX,IAAA,CAAAY,IAAA;QACA,KAAAL,OAAA,CAAAC,IAAA;MACA;IACA;IACAK,OAAA;MACAV,YAAA,CAAAW,UAAA;MACA,KAAAP,OAAA,CAAAC,IAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}