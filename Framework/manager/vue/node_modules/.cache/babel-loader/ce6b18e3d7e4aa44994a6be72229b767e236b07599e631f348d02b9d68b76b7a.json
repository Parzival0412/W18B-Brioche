{"ast":null,"code":"export default {\n  name: \"Invoice\",\n  data() {\n    return {\n      tableData: [],\n      pageNum: 1,\n      pageSize: 10,\n      total: 0,\n      invoiceNumber: null,\n      fromVisible: false,\n      form: {},\n      ids: []\n    };\n  },\n  created() {\n    this.load(1);\n  },\n  methods: {\n    load(pageNum) {\n      if (pageNum) this.pageNum = pageNum;\n      this.$request.get('/notice/selectPage', {\n        params: {\n          pageNum: this.pageNum,\n          pageSize: this.pageSize,\n          invoiceNumber: this.invoiceNumber\n        }\n      }).then(res => {\n        this.tableData = Array.isArray(res.data) ? res.data : [res.data];\n        this.total = res.data?.total;\n      });\n    },\n    reset() {\n      this.invoiceNumber = null;\n      this.load(1);\n    },\n    handleCurrentChange(pageNum) {\n      this.load(pageNum);\n    },\n    handleSelectionChange(rows) {\n      this.ids = rows.map(row => row.invoiceId);\n    },\n    handleAdd() {\n      this.form = {};\n      this.fromVisible = true;\n    },\n    save() {\n      this.$refs.formRef.validate(valid => {\n        if (valid) {\n          this.$request({\n            url: this.form.invoiceId ? '/notice/update' : '/notice/add',\n            method: this.form.invoiceId ? 'PUT' : 'POST',\n            data: this.form\n          }).then(res => {\n            if (res.code === '200') {\n              this.$message.success('保存成功');\n              this.load(1);\n              this.fromVisible = false;\n            } else {\n              this.$message.error(res.msg);\n            }\n          });\n        }\n      });\n    },\n    delBatch() {\n      if (!this.ids.length) {\n        this.$message.warning(\"请选择要删除的发票\");\n        return;\n      }\n      this.$confirm(\"您确定要批量删除这些发票吗？\", \"确认删除\", {\n        type: \"warning\"\n      }).then(() => {\n        this.$request.delete(\"/notice/delete/batch\", {\n          data: this.ids\n        }).then(res => {\n          if (res.code === \"200\") {\n            this.$message.success(\"批量删除成功\");\n            this.load(1);\n          } else {\n            this.$message.error(res.msg);\n          }\n        });\n      }).catch(() => {});\n    }\n  }\n};","map":{"version":3,"names":["name","data","tableData","pageNum","pageSize","total","invoiceNumber","fromVisible","form","ids","created","load","methods","$request","get","params","then","res","Array","isArray","reset","handleCurrentChange","handleSelectionChange","rows","map","row","invoiceId","handleAdd","save","$refs","formRef","validate","valid","url","method","code","$message","success","error","msg","delBatch","length","warning","$confirm","type","delete","catch"],"sources":["src/views/manager/Notice.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"search\">\r\n      <el-input placeholder=\"请输入发票编号查询\" style=\"width: 200px\" v-model=\"invoiceNumber\"></el-input>\r\n      <el-button type=\"info\" plain style=\"margin-left: 10px\" @click=\"load(1)\">查询</el-button>\r\n      <el-button type=\"warning\" plain style=\"margin-left: 10px\" @click=\"reset\">重置</el-button>\r\n    </div>\r\n\r\n    <div class=\"operation\">\r\n      <el-button type=\"primary\" plain @click=\"handleAdd\">新增</el-button>\r\n      <el-button type=\"danger\" plain @click=\"delBatch\">批量删除</el-button>\r\n    </div>\r\n\r\n    <div class=\"table\">\r\n      <el-table :data=\"tableData\" stripe @selection-change=\"handleSelectionChange\">\r\n        <el-table-column type=\"selection\" width=\"55\" align=\"center\"></el-table-column>\r\n        <el-table-column prop=\"invoiceId\" label=\"发票 ID\" width=\"80\" align=\"center\" sortable></el-table-column>\r\n        <el-table-column prop=\"invoiceNumber\" label=\"发票编号\" show-overflow-tooltip></el-table-column>\r\n        <el-table-column prop=\"issueDate\" label=\"开票日期\">\r\n          <template v-slot=\"scope\">\r\n            {{ scope.row.issueDate ? scope.row.issueDate.split(\"T\")[0] : '' }}\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"supplierName\" label=\"供应商\"></el-table-column>\r\n        <el-table-column prop=\"customerName\" label=\"客户\"></el-table-column>\r\n        <el-table-column label=\"商品明细\">\r\n          <template v-slot=\"scope\">\r\n            {{ scope.row.items ? JSON.parse(scope.row.items).item + \" - ¥\" + JSON.parse(scope.row.items).price : \"无数据\" }}\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"totalAmount\" label=\"总金额\"></el-table-column>\r\n        <el-table-column prop=\"gstIncluded\" label=\"是否含 GST\">\r\n          <template v-slot=\"scope\">\r\n            {{ scope.row.gstIncluded ? \"是\" : \"否\" }}\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n    </div>\r\n\r\n    <div class=\"pagination\">\r\n      <el-pagination\r\n          background\r\n          @current-change=\"handleCurrentChange\"\r\n          :current-page=\"pageNum\"\r\n          :page-sizes=\"[5, 10, 20]\"\r\n          :page-size=\"pageSize\"\r\n          layout=\"total, prev, pager, next\"\r\n          :total=\"total\">\r\n      </el-pagination>\r\n    </div>\r\n\r\n    <el-dialog title=\"发票信息\" :visible.sync=\"fromVisible\" width=\"40%\" :close-on-click-modal=\"false\" destroy-on-close>\r\n      <el-form label-width=\"100px\" style=\"padding-right: 50px\" :model=\"form\" ref=\"formRef\">\r\n        <el-form-item prop=\"invoiceNumber\" label=\"发票编号\">\r\n          <el-input v-model=\"form.invoiceNumber\" autocomplete=\"off\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item prop=\"issueDate\" label=\"开票日期\">\r\n          <el-date-picker v-model=\"form.issueDate\" type=\"date\" placeholder=\"选择日期\"></el-date-picker>\r\n        </el-form-item>\r\n        <el-form-item prop=\"supplierName\" label=\"供应商\">\r\n          <el-input v-model=\"form.supplierName\" autocomplete=\"off\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item prop=\"customerName\" label=\"客户\">\r\n          <el-input v-model=\"form.customerName\" autocomplete=\"off\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item prop=\"totalAmount\" label=\"总金额\">\r\n          <el-input v-model=\"form.totalAmount\" type=\"number\"></el-input>\r\n        </el-form-item>\r\n      </el-form>\r\n      <div slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button @click=\"fromVisible = false\">取消</el-button>\r\n        <el-button type=\"primary\" @click=\"save\">确定</el-button>\r\n      </div>\r\n    </el-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"Invoice\",\r\n  data() {\r\n    return {\r\n      tableData: [],\r\n      pageNum: 1,\r\n      pageSize: 10,\r\n      total: 0,\r\n      invoiceNumber: null,\r\n      fromVisible: false,\r\n      form: {},\r\n      ids: []\r\n    }\r\n  },\r\n  created() {\r\n    this.load(1)\r\n  },\r\n  methods: {\r\n    load(pageNum) {\r\n      if (pageNum) this.pageNum = pageNum;\r\n      this.$request.get('/notice/selectPage', {\r\n        params: {\r\n          pageNum: this.pageNum,\r\n          pageSize: this.pageSize,\r\n          invoiceNumber: this.invoiceNumber,\r\n        }\r\n      }).then(res => {\r\n        this.tableData = Array.isArray(res.data) ? res.data : [res.data];\r\n        this.total = res.data?.total;\r\n      })\r\n    },\r\n    reset() {\r\n      this.invoiceNumber = null;\r\n      this.load(1);\r\n    },\r\n    handleCurrentChange(pageNum) {\r\n      this.load(pageNum);\r\n    },\r\n    handleSelectionChange(rows) {\r\n      this.ids = rows.map(row => row.invoiceId);\r\n    },\r\n    handleAdd() {\r\n      this.form = {};\r\n      this.fromVisible = true;\r\n    },\r\n    save() {\r\n      this.$refs.formRef.validate((valid) => {\r\n        if (valid) {\r\n          this.$request({\r\n            url: this.form.invoiceId ? '/notice/update' : '/notice/add',\r\n            method: this.form.invoiceId ? 'PUT' : 'POST',\r\n            data: this.form\r\n          }).then(res => {\r\n            if (res.code === '200') {\r\n              this.$message.success('保存成功');\r\n              this.load(1);\r\n              this.fromVisible = false;\r\n            } else {\r\n              this.$message.error(res.msg);\r\n            }\r\n          })\r\n        }\r\n      })\r\n    },\r\n    delBatch() {\r\n      if (!this.ids.length) {\r\n        this.$message.warning(\"请选择要删除的发票\");\r\n        return;\r\n      }\r\n      this.$confirm(\"您确定要批量删除这些发票吗？\", \"确认删除\", { type: \"warning\" })\r\n          .then(() => {\r\n            this.$request.delete(\"/notice/delete/batch\", { data: this.ids }).then(res => {\r\n              if (res.code === \"200\") {\r\n                this.$message.success(\"批量删除成功\");\r\n                this.load(1);\r\n              } else {\r\n                this.$message.error(res.msg);\r\n              }\r\n            });\r\n          })\r\n          .catch(() => {});\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n</style>\r\n"],"mappings":"AA8EA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;MACAC,OAAA;MACAC,QAAA;MACAC,KAAA;MACAC,aAAA;MACAC,WAAA;MACAC,IAAA;MACAC,GAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAD,KAAAR,OAAA;MACA,IAAAA,OAAA,OAAAA,OAAA,GAAAA,OAAA;MACA,KAAAU,QAAA,CAAAC,GAAA;QACAC,MAAA;UACAZ,OAAA,OAAAA,OAAA;UACAC,QAAA,OAAAA,QAAA;UACAE,aAAA,OAAAA;QACA;MACA,GAAAU,IAAA,CAAAC,GAAA;QACA,KAAAf,SAAA,GAAAgB,KAAA,CAAAC,OAAA,CAAAF,GAAA,CAAAhB,IAAA,IAAAgB,GAAA,CAAAhB,IAAA,IAAAgB,GAAA,CAAAhB,IAAA;QACA,KAAAI,KAAA,GAAAY,GAAA,CAAAhB,IAAA,EAAAI,KAAA;MACA;IACA;IACAe,MAAA;MACA,KAAAd,aAAA;MACA,KAAAK,IAAA;IACA;IACAU,oBAAAlB,OAAA;MACA,KAAAQ,IAAA,CAAAR,OAAA;IACA;IACAmB,sBAAAC,IAAA;MACA,KAAAd,GAAA,GAAAc,IAAA,CAAAC,GAAA,CAAAC,GAAA,IAAAA,GAAA,CAAAC,SAAA;IACA;IACAC,UAAA;MACA,KAAAnB,IAAA;MACA,KAAAD,WAAA;IACA;IACAqB,KAAA;MACA,KAAAC,KAAA,CAAAC,OAAA,CAAAC,QAAA,CAAAC,KAAA;QACA,IAAAA,KAAA;UACA,KAAAnB,QAAA;YACAoB,GAAA,OAAAzB,IAAA,CAAAkB,SAAA;YACAQ,MAAA,OAAA1B,IAAA,CAAAkB,SAAA;YACA