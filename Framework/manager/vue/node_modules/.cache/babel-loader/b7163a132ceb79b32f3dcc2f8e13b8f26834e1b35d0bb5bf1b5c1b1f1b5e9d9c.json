{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: \"Login\",\n  data() {\n    return {\n      form: {\n        role: \"ADMIN\"\n      },\n      rules: {\n        username: [{\n          required: true,\n          message: \"Please enter the account number\",\n          trigger: \"blur\"\n        }],\n        password: [{\n          required: true,\n          message: \"Please enter the password.\",\n          trigger: \"blur\"\n        }]\n      }\n    };\n  },\n  methods: {\n    login() {\n      this.$refs.formRef.validate(valid => {\n        if (valid) {\n          this.$request.post(\"/login\", this.form).then(res => {\n            if (res.code === \"200\") {\n              localStorage.setItem(\"xm-user\", JSON.stringify(res.data));\n              this.$router.push(\"/\");\n              this.$message.success(\"Login successfully\");\n            } else {\n              this.$message.error(res.msg);\n            }\n          });\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["name","data","form","role","rules","username","required","message","trigger","password","methods","login","$refs","formRef","validate","valid","$request","post","then","res","code","localStorage","setItem","JSON","stringify","$router","push","$message","success","error","msg"],"sources":["src/views/Login.vue"],"sourcesContent":["<template>\n  <div class=\"login-container\">\n    <!-- 左侧大标题和背景图 -->\n    <div class=\"login-left\">\n      <div class=\"brand-title\">BRIOCHE<br />EXPRESS</div>\n    </div>\n\n    <!-- 右侧登录框 -->\n    <div class=\"login-right\">\n      <div class=\"login-box\">\n        <div class=\"login-title\">Welcome</div>\n        <el-form :model=\"form\" :rules=\"rules\" ref=\"formRef\">\n          <el-form-item prop=\"username\">\n            <el-input\n                placeholder=\"Username, email & phone number\"\n                v-model=\"form.username\"\n            ></el-input>\n          </el-form-item>\n          <el-form-item prop=\"password\">\n            <el-input\n                placeholder=\"Password\"\n                show-password\n                v-model=\"form.password\"\n            ></el-input>\n          </el-form-item>\n          <el-form-item>\n            <div class=\"login-options\">\n              <span></span>\n            </div>\n          </el-form-item>\n          <el-form-item>\n            <el-button type=\"primary\" class=\"login-btn\" @click=\"login\">Login</el-button>\n          </el-form-item>\n          <el-form-item>\n            <div class=\"register-text\">\n              Don’t have an account?\n              <span class=\"link\" @click=\"$router.push('/register')\">Register</span>\n            </div>\n          </el-form-item>\n        </el-form>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"Login\",\n  data() {\n    return {\n      form: { role: \"ADMIN\" },\n      rules: {\n        username: [{ required: true, message: \"Please enter the account number\", trigger: \"blur\" }],\n        password: [{ required: true, message: \"Please enter the password.\", trigger: \"blur\" }],\n      },\n    };\n  },\n  methods: {\n    login() {\n      this.$refs.formRef.validate((valid) => {\n        if (valid) {\n          this.$request.post(\"/login\", this.form).then((res) => {\n            if (res.code === \"200\") {\n              localStorage.setItem(\"xm-user\", JSON.stringify(res.data));\n              this.$router.push(\"/\");\n              this.$message.success(\"Login successfully\");\n            } else {\n              this.$message.error(res.msg);\n            }\n          });\n        }\n      });\n    },\n  },\n};\n</script>\n\n<style scoped>\n.login-container {\n  display: flex;\n  height: 100vh;\n  background-color: #fff;\n}\n\n.login-left {\n  flex: 1;\n  background-size: cover;\n  background-position: center;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.brand-title {\n  font-size: 110px;  /* 左边的 BRIOCHE EXPRESS 更大 */\n  font-weight: 900;\n  color: #000;\n  text-align: center;\n  line-height: 1.2;\n}\n\n.login-right {\n  flex: 1;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background-color: white;\n}\n\n.login-box {\n  width: 500px;         /* 登录框宽度更大 */\n  background: #fff;\n  padding: 40px;   /* 加大内边距，内容不挤 */\n  border-radius: 14px;\n  box-shadow: 0 8px 45px rgba(0, 0, 0, 0.1);\n}\n\n.login-title {\n  text-align: center;\n  font-size: 32px;       /* 登录标题字体更大 */\n  font-weight: 700;\n  margin-bottom: 30px;\n  color: #000;\n}\n\n.el-form-item {\n  margin-bottom: 22px;\n}\n\n.el-input__inner {\n  font-size: 16px !important; /* 输入框文字更大 */\n  padding: 12px 14px !important;\n}\n\n.login-btn {\n  width: 100%;\n  background-color: #000;\n  border-color: #000;\n  color: white;\n  font-size: 18px;\n  padding: 14px 0;\n  border-radius: 6px;\n}\n\n.login-options {\n  display: flex;\n  justify-content: space-between;\n  font-size: 14px;\n  color: #666;\n}\n\n.forgot {\n  color: #888;\n  cursor: pointer;\n}\n\n.register-text {\n  text-align: center;\n  font-size: 15px;\n  color: #666;\n  margin-top: 10px;\n}\n\n.link {\n  color: #2a60c9;\n  cursor: pointer;\n  margin-left: 5px;\n  font-weight: 500;\n}\n\n</style>\n"],"mappings":";AA8CA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,IAAA;QAAAC,IAAA;MAAA;MACAC,KAAA;QACAC,QAAA;UAAAC,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAC,QAAA;UAAAH,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MACA;IACA;EACA;EACAE,OAAA;IACAC,MAAA;MACA,KAAAC,KAAA,CAAAC,OAAA,CAAAC,QAAA,CAAAC,KAAA;QACA,IAAAA,KAAA;UACA,KAAAC,QAAA,CAAAC,IAAA,gBAAAf,IAAA,EAAAgB,IAAA,CAAAC,GAAA;YACA,IAAAA,GAAA,CAAAC,IAAA;cACAC,YAAA,CAAAC,OAAA,YAAAC,IAAA,CAAAC,SAAA,CAAAL,GAAA,CAAAlB,IAAA;cACA,KAAAwB,OAAA,CAAAC,IAAA;cACA,KAAAC,QAAA,CAAAC,OAAA;YACA;cACA,KAAAD,QAAA,CAAAE,KAAA,CAAAV,GAAA,CAAAW,GAAA;YACA;UACA;QACA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}